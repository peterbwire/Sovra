// Snapshot barriers for unconditional observation and conditional conflict tests.
fn main() {
    if std::arg_count() != 2 && std::arg_count() != 3 { std::set_exit_code(1); return; }
    let path = std::arg(0);
    let loaded = std::read_text(path);
    if loaded.ok == false && (std::arg_count() != 3 || loaded.error != "not_found") {
        print(loaded.error); std::set_exit_code(1); return;
    }
    if loaded.ok { print("snapshot:" + loaded.text); } else { print("snapshot:missing"); }
    let release = std::read_line();
    if release.eof { std::set_exit_code(1); return; }
    if std::arg_count() == 3 {
        let saved = std::write_text_if(path, loaded.ok, loaded.text, loaded.text + "|" + std::arg(1));
        if saved.ok { print("saved"); } else { print("rejected:" + saved.error); }
        return;
    }
    let saved = std::write_text(path, loaded.text + "|" + std::arg(1));
    if saved.ok == false { print(saved.error); std::set_exit_code(1); return; }
    print("saved");
}
