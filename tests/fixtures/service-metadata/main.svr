service mail {
    fn send(value: Result<Text, Error>, context: Int) -> Receipt;
    fn ping()
    // A body may start after comments and whitespace.
    {}
}

fn typed_local() {
    let mail: Client = mail.send("hello", 1)
    mail.local_operation()
}

fn binary_calls() {
    return mail.send("hello", 1 + 2 * 3) == mail.send("world", 4)
}

fn qualified_call() {
    std::println(mail.send("hello", 1))
}
