fn recurse(depth: Int) -> Int {
    return recurse(depth + 1)
}

struct Point { x: Int, y: Int }

fn side() -> Bool {
    std::println("unexpected side effect")
    return true
}

fn main() {
    let mode = std::arg(0)
    if mode == "arguments" {
        std::print(std::arg_count())
        print(std::arg(1))
    } else if mode == "text" {
        let split = std::split_once("left:right:tail", ":")
        std::println(split.found)
        std::println(split.before)
        std::println(split.after)
        let minimum = std::parse_int("-9223372036854775808")
        std::println(minimum.ok)
        std::println(minimum.value)
        std::println(std::parse_int("9223372036854775808").ok)
        std::println(std::lines_unique("one\ntwo\n"))
        std::println(std::lines_unique("one\none\n"))
        std::println(std::escape_terminal("\n\t"))
    } else if mode == "values" {
        let original = [[1, 2], [3, 4]]
        let mut copy = original
        copy[0] = [9, 8]
        std::println(original[0][0])
        std::println(copy[0][0])
        std::println(original == [[1, 2], [3, 4]])
        let point = Point { x: 2, y: 3 }
        std::println(point == Point { y: 3, x: 2 })
        std::println(std::to_string(point))
        let mut sum = 0
        let mut i = 0
        while i < 4 { sum = sum + i; i = i + 1 }
        std::println(sum)
        if false && side() { std::println("wrong") }
        if true || side() { std::println("short circuit") }
        std::println(0.0 / (0.0 - 1.0))
    } else if mode == "stdin" {
        let first = std::read_line()
        std::println(first.eof)
        std::println(std::len(first.text))
        let second = std::read_line()
        std::println(second.eof)
        std::println(std::len(second.text))
    } else if mode == "argument-error" {
        std::println(std::arg(99))
    } else if mode == "exit-error" {
        std::set_exit_code(126)
    } else if mode == "overflow" {
        std::println("before error")
        let maximum = 9223372036854775807
        std::println(maximum + 1)
    } else if mode == "division" {
        std::println("before error")
        let zero = 0
        std::println(1 / zero)
    } else if mode == "index" {
        let values = [1, 2]
        std::println(values[2])
    } else if mode == "recursion" {
        std::println(recurse(0))
    } else if mode == "exit" {
        std::set_exit_code(125)
        std::println("requested exit")
    } else if mode == "read" {
        let loaded = std::read_text(std::arg(1))
        std::println(loaded.ok)
        std::println(loaded.error)
        std::println(std::len(loaded.text))
    } else if mode == "copy" {
        let loaded = std::read_text(std::arg(1))
        if loaded.ok {
            let saved = std::write_text(std::arg(2), loaded.text)
            std::println(saved.ok)
            std::println(saved.error)
            if saved.ok == false { std::set_exit_code(1) }
        } else {
            std::println(loaded.error)
            std::set_exit_code(1)
        }
    }
}
