// Application-owned task records use general Sovra text and file operations.
struct Task { id: Int, title: String, done: Bool }
struct Tasks { rows: String, next_id: Int }
struct Loaded { ok: Bool, tasks: Tasks }
struct ParsedTask { ok: Bool, task: Task }
struct ViewOptions { ok: Bool, mode: String, query: String }
struct PageOptions { ok: Bool, index: Int }

// Navigation is separate from existing task and search/filter formats.
fn page_options(path: String) -> PageOptions {
    let file = std::read_text(path + ".page");
    if file.ok == false { return PageOptions { ok: file.error == "not_found", index: 0 }; }
    let header = std::split_once(file.text, "\n");
    let value = std::split_once(header.after, "\n");
    let index = std::parse_int(value.before);
    let valid = header.before == "SVR-TASK-PAGE-1" && header.found && value.found &&
        value.after == "" && index.ok && index.value >= 0;
    return PageOptions { ok: valid, index: index.value };
}
fn matching_count(tasks: Tasks, options: ViewOptions) -> Int {
    let mut rest = tasks.rows;
    let mut count = 0;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        if matches_view(parsed.task, options) { count = count + 1; }
        rest = line.after;
    }
    return count;
}
fn page_count(count: Int) -> Int {
    let mut remaining = count;
    let mut pages = 1;
    while remaining > 25 { pages = pages + 1; remaining = remaining - 25; }
    return pages;
}
fn clamped_page(index: Int, pages: Int) -> Int {
    if (index >= pages) { return pages - 1; }
    return index;
}
fn view_preview(text: String, label: String) -> String {
    if std::len(text) <= 512 {
        let escaped = std::escape_terminal(text);
        if std::len(escaped) <= 512 { return escaped; }
    }
    return "(long " + label + ": " + std::to_string(std::len(text)) + " UTF-8 bytes)";
}

// Private application preferences are separate from the durable task format.
fn view_options(path: String) -> ViewOptions {
    let file = std::read_text(path + ".view");
    if file.ok == false {
        return ViewOptions { ok: file.error == "not_found", mode: "all", query: "" };
    }
    let header = std::split_once(file.text, "\n");
    let mode = std::split_once(header.after, "\n");
    let valid = header.before == "SVR-TASK-VIEW-1" && header.found && mode.found &&
        (mode.before == "all" || mode.before == "open" || mode.before == "completed") &&
        std::escape_terminal(mode.after) == mode.after && title_has_line_break(mode.after) == false;
    return ViewOptions { ok: valid, mode: mode.before, query: mode.after };
}
fn matches_view(task: Task, options: ViewOptions) -> Bool {
    if options.mode == "open" && task.done { return false; }
    if options.mode == "completed" && task.done == false { return false; }
    if options.query == "" { return true; }
    return std::split_once(task.title, options.query).found;
}

fn fail(message: String) {
    std::set_exit_code(1);
    print(std::escape_terminal(message));
}
fn title_has_line_break(title: String) -> Bool {
    let line_feed = std::split_once(title, "\n");
    let carriage_return = std::split_once(title, "\r");
    return line_feed.found || carriage_return.found;
}
fn empty_task() -> Task { return Task { id: 0, title: "", done: false }; }
fn empty_tasks() -> Tasks { return Tasks { rows: "", next_id: 1 }; }
fn row(task: Task) -> String {
    let mut done = "0";
    if task.done { done = "1"; }
    return std::to_string(task.id) + "|" + done + "|" + task.title + "\n";
}
fn parse_row(line: String, allow_empty: Bool) -> ParsedTask {
    let id_part = std::split_once(line, "|");
    if id_part.found == false { return ParsedTask { ok: false, task: empty_task() }; }
    let done_part = std::split_once(id_part.after, "|");
    if done_part.found == false { return ParsedTask { ok: false, task: empty_task() }; }
    let parsed = std::parse_int(id_part.before);
    if parsed.ok == false || parsed.value < 0 { return ParsedTask { ok: false, task: empty_task() }; }
    if done_part.before != "0" && done_part.before != "1" {
        return ParsedTask { ok: false, task: empty_task() };
    }
    if parsed.value == 0 {
        if allow_empty == false || done_part.before != "0" || done_part.after != "" {
            return ParsedTask { ok: false, task: empty_task() };
        }
    } else if done_part.after == "" || title_has_line_break(done_part.after) {
        return ParsedTask { ok: false, task: empty_task() };
    }
    return ParsedTask { ok: true, task: Task {
        id: parsed.value, title: done_part.after, done: done_part.before == "1"
    } };
}
fn find_id(tasks: Tasks, id: Int) -> Task {
    let mut rest = tasks.rows;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        if (parsed.task.id == id) { return parsed.task; }
        rest = line.after;
    }
    return empty_task();
}
fn find_title(tasks: Tasks, title: String) -> Task {
    let mut rest = tasks.rows;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        if (parsed.task.title == title) { return parsed.task; }
        rest = line.after;
    }
    return empty_task();
}
fn add(tasks: Tasks, title: String, announce: Bool) -> Tasks {
    if title == "" { fail("error: empty title"); return tasks; }
    if title_has_line_break(title) { fail("error: title contains a line break"); return tasks; }
    if (std::escape_terminal(title) != title) {
        fail("error: title contains terminal control"); return tasks;
    }
    if find_title(tasks, title).id > 0 { fail("error: duplicate title"); return tasks; }
    if tasks.next_id == 9223372036854775807 {
        fail("error: task ID exhausted"); return tasks;
    }
    let task = Task { id: tasks.next_id, title: title, done: false };
    if (announce) { print("added " + std::to_string(task.id)); }
    return Tasks { rows: tasks.rows + row(task), next_id: tasks.next_id + 1 };
}
fn replace(tasks: Tasks, id: Int, completed: Bool, deleting: Bool) -> Tasks {
    let mut rest = tasks.rows;
    let mut result = "";
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        if (parsed.task.id == id) {
            if (deleting == false) {
                result = result + row(Task { id: id, title: parsed.task.title, done: completed });
            }
        } else { result = result + row(parsed.task); }
        rest = line.after;
    }
    return Tasks { rows: result, next_id: tasks.next_id };
}
fn complete(tasks: Tasks, id: Int, announce: Bool) -> Tasks {
    if find_id(tasks, id).id == 0 {
        fail("error: missing " + std::to_string(id)); return tasks;
    }
    if (announce) { print("completed " + std::to_string(id)); }
    return replace(tasks, id, true, false);
}
fn rename(tasks: Tasks, id: Int, title: String) -> Tasks {
    if title == "" { fail("error: empty title"); return tasks; }
    if title_has_line_break(title) { fail("error: title contains a line break"); return tasks; }
    if (std::escape_terminal(title) != title) {
        fail("error: title contains terminal control"); return tasks;
    }
    let existing = find_title(tasks, title);
    if (existing.id != 0 && existing.id != id) { fail("error: duplicate title"); return tasks; }
    let mut rest = tasks.rows;
    let mut rows = "";
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let task = parse_row(line.before, false).task;
        if (task.id == id) { rows = rows + row(Task { id: id, title: title, done: task.done }); }
        else { rows = rows + row(task); }
        rest = line.after;
    }
    return Tasks { rows: rows, next_id: tasks.next_id };
}
fn remove(tasks: Tasks, id: Int, announce: Bool) -> Tasks {
    if find_id(tasks, id).id == 0 {
        fail("error: missing " + std::to_string(id)); return tasks;
    }
    if (announce) { print("deleted " + std::to_string(id)); }
    return replace(tasks, id, false, true);
}
fn list(tasks: Tasks) {
    print("tasks:");
    let mut rest = tasks.rows;
    let mut count = 0;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        let mut status = "open";
        if parsed.task.done { status = "done"; }
        print(std::to_string(parsed.task.id) + " | " + status + " | " +
              std::escape_terminal(parsed.task.title));
        count = count + 1;
        rest = line.after;
    }
    print("count " + std::to_string(count));
}
// Private, versioned view stream for the local browser adapter.
fn gui_list(tasks: Tasks) {
    print("SVR-GUI-1");
    let mut rest = tasks.rows;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        let mut done = "0";
        if parsed.task.done { done = "1"; }
        print(std::to_string(parsed.task.id) + "|" + done + "|" + parsed.task.title);
        rest = line.after;
    }
}
// Private UI component stream. The host renders nodes, not task rules.
fn ui_view(tasks: Tasks, grouped: Bool, options: ViewOptions, requested_page: Int) {
    if (grouped) { print("SVR-UI-2"); } else { print("SVR-UI-1"); }
    print("heading|Sovra Task Manager");
    let mut rest = tasks.rows;
    let mut count = 0;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        count = count + 1;
        rest = line.after;
    }
    let mut noun = "tasks";
    if (count == 1) { noun = "task"; }
    print("text|" + std::to_string(count) + " " + noun + " saved locally");
    let mut matches = count;
    if (grouped) { matches = matching_count(tasks, options); }
    let pages = page_count(matches);
    let page = clamped_page(requested_page, pages);
    let offset = page * 25;
    if (grouped) { print("group|add-task|vertical|card"); }
    print("input|add|Task title|Add");
    if (grouped) {
        print("end|add-task");
        print("group|task-list|vertical|card");
    }
    if count == 0 { print("text|No tasks yet."); }
    rest = tasks.rows;
    let mut shown = 0;
    let mut matched = 0;
    while rest != "" {
        let line = std::split_once(rest, "\n");
        let parsed = parse_row(line.before, false);
        if grouped == false || matches_view(parsed.task, options) {
            if grouped == false || (matched >= offset && shown < 25) {
                shown = shown + 1;
                let mut status = "Open";
                if parsed.task.done { status = "Done"; }
                if (grouped) { print("group|task-" + std::to_string(parsed.task.id) + "|horizontal|plain"); }
                let mut display_title = "";
                if (grouped) { display_title = view_preview(parsed.task.title, "title"); }
                else { display_title = std::escape_terminal(parsed.task.title); }
                print("text|" + status + " #" + std::to_string(parsed.task.id) + " - " + display_title);
                if parsed.task.done == false {
                    print("button|complete-" + std::to_string(parsed.task.id) + "|Complete");
                }
                print("button|delete-" + std::to_string(parsed.task.id) + "|Delete");
                if (grouped) { print("end|task-" + std::to_string(parsed.task.id)); }
                if (grouped) {
                    print("input|rename-" + std::to_string(parsed.task.id) + "|New title for task #" +
                          std::to_string(parsed.task.id) + " (Escape cancels draft)|Save");
                }
            }
            matched = matched + 1;
        }
        rest = line.after;
    }
    if (grouped) {
        if shown == 0 && count > 0 { print("text|No matching tasks."); }
        print("end|task-list");
        print("group|view-options|vertical|card");
        print("text|Showing " + std::to_string(shown) + " of " + std::to_string(count) +
              " tasks; filter: " + options.mode + "; search: " + view_preview(options.query, "search"));
        print("input|search|Search titles (case-sensitive)|Search");
        print("group|filters|horizontal|plain");
        print("button|filter-all|All");
        print("button|filter-open|Open");
        print("button|filter-completed|Completed");
        print("button|clear-search|Clear search");
        print("end|filters");
        print("group|pagination|horizontal|plain");
        print("text|Page " + std::to_string(page + 1) + " of " + std::to_string(pages));
        if page > 0 { print("button|page-previous|Previous page"); }
        if (page + 1 < pages) { print("button|page-next|Next page"); }
        print("end|pagination");
        print("end|view-options");
    }
}
fn encode(tasks: Tasks) -> String {
    return "SVR-TASKS-2\n" + std::to_string(tasks.next_id) + "\n" + tasks.rows;
}
fn decode(text: String) -> Loaded {
    let header = std::split_once(text, "\n");
    if header.found == false || (header.before != "SVR-TASKS-1" && header.before != "SVR-TASKS-2") {
        return Loaded { ok: false, tasks: empty_tasks() };
    }
    let next_line = std::split_once(header.after, "\n");
    let next = std::parse_int(next_line.before);
    if next_line.found == false || next.ok == false || next.value <= 0 {
        return Loaded { ok: false, tasks: empty_tasks() };
    }
    let mut tasks = Tasks { rows: "", next_id: next.value };
    let mut rest = next_line.after;
    let mut lines = 0;
    let mut ids = "";
    let mut titles = "";
    while rest != "" {
        let line = std::split_once(rest, "\n");
        if line.found == false { return Loaded { ok: false, tasks: empty_tasks() }; }
        let parsed = parse_row(line.before, header.before == "SVR-TASKS-1");
        if parsed.ok == false { return Loaded { ok: false, tasks: empty_tasks() }; }
        if parsed.task.id > 0 {
            if parsed.task.id >= next.value {
                return Loaded { ok: false, tasks: empty_tasks() };
            }
            ids = ids + std::to_string(parsed.task.id) + "\n";
            titles = titles + parsed.task.title + "\n";
            tasks = Tasks { rows: tasks.rows + row(parsed.task), next_id: next.value };
        }
        lines = lines + 1;
        if header.before == "SVR-TASKS-1" && lines > 3 {
            return Loaded { ok: false, tasks: empty_tasks() };
        }
        rest = line.after;
    }
    if header.before == "SVR-TASKS-1" && lines != 3 {
        return Loaded { ok: false, tasks: empty_tasks() };
    }
    if std::lines_unique(ids) == false || std::lines_unique(titles) == false {
        return Loaded { ok: false, tasks: empty_tasks() };
    }
    return Loaded { ok: true, tasks: tasks };
}
fn interactive(path: String, persistent: Bool) {
    let mut tasks = empty_tasks();
    let mut saved_text = "";
    let mut file_existed = false;
    if (persistent) {
        let file = std::read_text(path);
        if file.ok {
            let loaded = decode(file.text);
            if loaded.ok == false { fail("error: invalid task file"); return; }
            tasks = loaded.tasks;
            saved_text = file.text;
            file_existed = true;
        } else if file.error != "not_found" {
            fail("error: load " + file.error); return;
        }
    }
    print("Task Manager");
    print("commands: add, list, complete, delete, quit");
    let mut running = true;
    while (running) {
        print("command:");
        let command = std::read_line();
        if command.eof { print("bye"); return; }
        if (persistent && command.text != "quit") {
            let latest = std::read_text(path);
            if latest.ok {
                let loaded = decode(latest.text);
                if loaded.ok == false { fail("error: invalid task file"); return; }
                tasks = loaded.tasks;
                saved_text = latest.text;
                file_existed = true;
            } else if (latest.error == "not_found") {
                tasks = empty_tasks();
                saved_text = "";
                file_existed = false;
            } else { fail("error: load " + latest.error); return; }
        }
        if command.text == "quit" { print("bye"); running = false; }
        else if command.text == "list" { list(tasks); }
        else if command.text == "add" || command.text == "complete" || command.text == "delete" {
            print("title:");
            let input = std::read_line();
            if input.eof { fail("error: unexpected EOF"); return; }
            let mut updated = tasks;
            let mut success = "";
            if command.text == "add" {
                updated = add(tasks, input.text, false);
                if (updated != tasks) { success = "added " + std::to_string(tasks.next_id); }
            }
            else if command.text == "complete" {
                let task = find_title(tasks, input.text);
                if task.id == 0 { fail("error: missing title " + input.text); }
                else {
                    updated = complete(tasks, task.id, false);
                    success = "completed " + std::to_string(task.id);
                }
            } else {
                let task = find_title(tasks, input.text);
                if task.id == 0 { fail("error: missing title " + input.text); }
                else {
                    updated = remove(tasks, task.id, false);
                    success = "deleted " + std::to_string(task.id);
                }
            }
            if (persistent && updated != tasks) {
                let current = std::read_text(path);
                if current.ok {
                    if (file_existed == false || current.text != saved_text) {
                        fail("error: task file changed"); return;
                    }
                } else if (current.error == "not_found") {
                    if (file_existed) { fail("error: task file changed"); return; }
                } else { fail("error: load " + current.error); return; }
                let next_text = encode(updated);
                let saved = std::write_text(path, next_text);
                if saved.ok == false { fail("error: save " + saved.error); return; }
                saved_text = next_text;
                file_existed = true;
            }
            tasks = updated;
            if success != "" { print(success); }
        } else { fail("error: unknown command " + command.text); }
    }
}
fn one_shot(command: String, path: String, title: String, value: String) {
    let mut tasks = empty_tasks();
    let file = std::read_text(path);
    if file.ok {
        let loaded = decode(file.text);
        if loaded.ok == false { fail("error: invalid task file"); return; }
        tasks = loaded.tasks;
    } else if file.error != "not_found" {
        fail("error: load " + file.error); return;
    }
    if command == "list" { list(tasks); return; }
    if command == "gui-list" { gui_list(tasks); return; }
    if command == "ui-view" {
        ui_view(tasks, false, ViewOptions { ok: true, mode: "all", query: "" }, 0); return;
    }
    if command == "ui-layout-view" {
        let options = view_options(path);
        if options.ok == false { fail("error: invalid or unreadable view preferences"); return; }
        let page = page_options(path);
        if page.ok == false { fail("error: invalid or unreadable page preferences"); return; }
        ui_view(tasks, true, options, page.index); return;
    }
    if command == "ui-event" {
        if title == "page-next" || title == "page-previous" {
            if value != "" { fail("error: unexpected UI value"); return; }
            let options = view_options(path);
            let page = page_options(path);
            if options.ok == false || page.ok == false {
                fail("error: invalid or unreadable view/page preferences"); return;
            }
            let pages = page_count(matching_count(tasks, options));
            let mut index = clamped_page(page.index, pages);
            if title == "page-next" {
                if (index + 1 >= pages) { fail("error: page unavailable"); return; }
                index = index + 1;
            } else {
                if index == 0 { fail("error: page unavailable"); return; }
                index = index - 1;
            }
            let saved = std::write_text(path + ".page", "SVR-TASK-PAGE-1\n" + std::to_string(index) + "\n");
            if saved.ok == false { fail("error: save page " + saved.error); return; }
            print("page updated"); return;
        }
        if title == "search" || title == "clear-search" || title == "filter-all" ||
            title == "filter-open" || title == "filter-completed" {
            let options = view_options(path);
            if options.ok == false { fail("error: invalid or unreadable view preferences"); return; }
            let page = page_options(path);
            if page.ok == false { fail("error: invalid or unreadable page preferences"); return; }
            let mut mode = options.mode;
            let mut query = options.query;
            if title == "search" {
                if (title_has_line_break(value) || std::escape_terminal(value) != value) {
                    fail("error: search contains terminal control"); return;
                }
                query = value;
            } else {
                if value != "" { fail("error: unexpected UI value"); return; }
                if title == "clear-search" { query = ""; }
                if title == "filter-all" { mode = "all"; }
                if title == "filter-open" { mode = "open"; }
                if title == "filter-completed" { mode = "completed"; }
            }
            let saved = std::write_text(path + ".view", "SVR-TASK-VIEW-1\n" + mode + "\n" + query);
            if saved.ok == false { fail("error: save view " + saved.error); return; }
            let reset = std::write_text(path + ".page", "SVR-TASK-PAGE-1\n0\n");
            if reset.ok == false { fail("error: reset page " + reset.error); return; }
            print("view updated"); return;
        }
        if title == "add" {
            let updated = add(tasks, value, false);
            if (updated == tasks) { return; }
            let saved = std::write_text(path, encode(updated));
            if saved.ok == false { fail("error: save " + saved.error); return; }
            print("added " + std::to_string(tasks.next_id));
            return;
        }
        let renamed = std::split_once(title, "rename-");
        if renamed.found && renamed.before == "" {
            let id = std::parse_int(renamed.after);
            if id.ok == false || id.value <= 0 { fail("error: invalid UI action"); return; }
            if find_id(tasks, id.value).id == 0 { fail("error: task unavailable"); return; }
            let updated = rename(tasks, id.value, value);
            if (updated == tasks) { return; }
            let saved = std::write_text(path, encode(updated));
            if saved.ok == false { fail("error: save " + saved.error); return; }
            print("renamed " + std::to_string(id.value));
            return;
        }
        if value != "" { fail("error: unexpected UI value"); return; }
        let completed = std::split_once(title, "complete-");
        let deleted = std::split_once(title, "delete-");
        let mut id_text = "";
        let mut removing = false;
        if completed.found && completed.before == "" { id_text = completed.after; }
        else if deleted.found && deleted.before == "" {
            id_text = deleted.after;
            removing = true;
        }
        let id = std::parse_int(id_text);
        if id.ok == false || id.value <= 0 {
            fail("error: invalid UI action"); return;
        }
        let task = find_id(tasks, id.value);
        if task.id == 0 || (task.done && removing == false) {
            fail("error: task unavailable"); return;
        }
        let mut updated = tasks;
        if (removing) { updated = remove(tasks, id.value, false); }
        else { updated = complete(tasks, id.value, false); }
        let saved = std::write_text(path, encode(updated));
        if saved.ok == false { fail("error: save " + saved.error); return; }
        if (removing) { print("deleted " + std::to_string(id.value)); }
        else { print("completed " + std::to_string(id.value)); }
        return;
    }
    if title_has_line_break(title) { fail("error: title contains a line break"); return; }
    let mut updated = tasks;
    let mut success = "";
    if command == "add" {
        updated = add(tasks, title, false);
        if (updated != tasks) { success = "added " + std::to_string(tasks.next_id); }
    } else {
        let task = find_title(tasks, title);
        if task.id == 0 { fail("error: missing title " + title); return; }
        if command == "complete" {
            updated = complete(tasks, task.id, false);
            success = "completed " + std::to_string(task.id);
        } else {
            updated = remove(tasks, task.id, false);
            success = "deleted " + std::to_string(task.id);
        }
    }
    if (updated != tasks) {
        let saved = std::write_text(path, encode(updated));
        if saved.ok == false { fail("error: save " + saved.error); return; }
    }
    if success != "" { print(success); }
}
fn usage() {
    print("Task Manager");
    print("usage: interactive [path] | list <path> | add <path> <title>");
    print("       complete <path> <title> | delete <path> <title> | demo");
}
fn main() {
    if std::arg_count() == 0 { usage(); return; }
    if std::arg_count() > 0 {
        if std::arg(0) == "help" || std::arg(0) == "--help" {
            if std::arg_count() != 1 { fail("error: expected help"); return; }
            usage(); return;
        }
        if std::arg(0) == "demo" {
            if std::arg_count() != 1 { fail("error: expected demo"); return; }
            demo(); return;
        }
        if std::arg(0) == "interactive" {
            if std::arg_count() > 2 { fail("error: expected interactive [path]"); return; }
            if std::arg_count() == 2 { interactive(std::arg(1), true); }
            else { interactive("", false); }
            return;
        }
        let command = std::arg(0);
        if command == "list" {
            if std::arg_count() != 2 { fail("error: expected list <path>"); return; }
            one_shot(command, std::arg(1), "", ""); return;
        }
        if command == "gui-list" || command == "ui-view" || command == "ui-layout-view" {
            if std::arg_count() != 2 { fail("error: expected " + command + " <path>"); return; }
            one_shot(command, std::arg(1), "", ""); return;
        }
        if command == "ui-event" {
            if std::arg_count() != 3 && std::arg_count() != 4 {
                fail("error: expected ui-event <path> <action> [value]"); return;
            }
            let mut value = "";
            if std::arg_count() == 4 { value = std::arg(3); }
            one_shot(command, std::arg(1), std::arg(2), value); return;
        }
        if command == "add" || command == "complete" || command == "delete" {
            if std::arg_count() != 3 {
                fail("error: expected " + command + " <path> <title>"); return;
            }
            one_shot(command, std::arg(1), std::arg(2), ""); return;
        }
        fail("error: expected help, demo, interactive, list, add, complete or delete"); return;
    }
}
fn demo() {
    let mut tasks = empty_tasks();
    list(tasks);
    tasks = add(tasks, "Write tests", true);
    tasks = add(tasks, "Review café release", true);
    tasks = add(tasks, "Ship documentation", true);
    tasks = add(tasks, "Overflow", true);
    tasks = add(tasks, "", true);
    tasks = complete(tasks, 2, true);
    tasks = complete(tasks, 2, true);
    tasks = complete(tasks, 99, true);
    list(tasks);
    tasks = remove(tasks, 1, true);
    tasks = remove(tasks, 1, true);
    tasks = remove(tasks, 0, true);
    tasks = add(tasks, "Replacement", true);
    list(tasks);
    tasks = remove(tasks, 2, true);
    tasks = remove(tasks, 3, true);
    tasks = remove(tasks, 4, true);
    tasks = remove(tasks, 5, true);
    list(tasks);
    // The demo deliberately demonstrates rejected operations.
    std::set_exit_code(0);
}
