use library::sequences;

fn main() {
    let original = [2, 3, 4];
    let mut selected = library::sequences::tail(original);
    selected[0] = 9;
    print(original);
    print(selected);
    let widened: [Float] = library::sequences::tail(original);
    print(widened[0] / 2);
    let empty: [Int] = [];
    print(library::sequences::tail(empty));
    let samples = library::sequences::last_sample();
    print(samples[0].value);
}

fn test_tail() {
    let empty: [Int] = [];
    print(std::array_len(library::sequences::tail(empty)));
}
