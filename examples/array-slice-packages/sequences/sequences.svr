mod sequences {
    type Ints = [Int];
    export struct Sample {
        value: Int
    }

    export fn tail(values: Ints) -> Ints {
        if std::array_len(values) == 0 {
            return [];
        }
        return std::array_slice(values, 1, std::array_len(values));
    }

    export fn last_sample() -> [Sample] {
        return std::array_slice([Sample {
            value: 7
        }, Sample {
            value: 9
        }], 1, 2);
    }

    export fn keep_positive(values: Ints) -> Ints {
        let mut output: Ints = [];
        let mut index = 0;
        while index < std::array_len(values) {
            if values[index] > 0 {
                output = std::array_append(output, values[index]);
            }
            index = index + 1;
        }
        return output;
    }

    export fn join_float(left: [Float], right: [Int]) -> [Float] {
        return std::array_concat(left, right);
    }

    export fn appended_sample() -> [Sample] {
        let empty: [Sample] = [];
        return std::array_append(empty, Sample {
            value: 7
        });
    }

    export fn reversed(values: Ints) -> Ints {
        let mut result: Ints = [];
        let mut index = std::array_len(values);
        while index > 0 {
            index = index - 1;
            result = std::array_append(result, values[index]);
        }
        return result;
    }

    export fn sorted(values: Ints) -> Ints {
        let mut result = values;
        let mut index = 1;
        while index < std::array_len(result) {
            let mut position = index;
            while position > 0 {
                if result[position - 1] > result[position] {
                    let previous = result[position - 1];
                    result[position - 1] = result[position];
                    result[position] = previous;
                    position = position - 1;
                } else {
                    position = 0;
                }
            }
            index = index + 1;
        }
        return result;
    }
}
