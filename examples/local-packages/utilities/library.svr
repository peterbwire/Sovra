mod arithmetic {
    fn product(left: Int, right: Int) -> Int {
        return left * right
    }

    export fn square(value: Int) -> Int {
        return arithmetic::product(value, value)
    }
}

mod geometry {
    export struct Point {
        x: Float,
        y: Float,
    }

    export fn squared_length(point: Point) -> Float {
        return point.x * point.x + point.y * point.y
    }
}
