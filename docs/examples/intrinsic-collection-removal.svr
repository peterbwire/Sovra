fn without<K:std::Key,V>(map:std::Map<K,V>,key:K)->std::Option<std::Map<K,V>>{
    return std::map_remove(map,key);
}
fn main()->Bool{
    let empty:std::Map<String,Int>=std::map_new();
    let original=std::map_insert(std::map_insert(empty,"keep",7),"remove",9);
    let result=without::<String,Int>(original,"remove");
    match result{
        std::Option::Some(updated)=>{
            return std::map_len(original)==2 && std::map_len(updated)==1
                && std::map_contains(original,"remove")
                && std::map_contains(updated,"keep")
                && std::map_contains(updated,"remove")==false;
        },
        std::Option::None()=>{return false;}
    }
}
